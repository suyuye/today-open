<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== 全局字体 =====================
         默认字体族：优先 Windows 11 的 Segoe UI Variable，回退 Segoe UI / 微软雅黑。
         默认字号 12.5px，默认行高 1.6（约 20px，见 body 文本）。 -->
    <FontFamily x:Key="BaseFontFamily">Segoe UI Variable, Segoe UI, Microsoft YaHei, PingFang SC, sans-serif</FontFamily>

    <!-- ===================== 按钮：基础样式（次按钮） ===================== -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
        <Setter Property="BorderThickness" Value="0.8"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F8F7F5"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#C4C1BB"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#F0EFEB"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#BBBBBB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 按钮：主按钮 ===================== -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="Foreground" Value="{StaticResource TextInverse}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrandHover}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BrandPressed}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F0D8C8"/>
                            <Setter Property="Foreground" Value="#B3FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 按钮：危险按钮 ===================== -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="#0FC0392B"/>
        <Setter Property="Foreground" Value="{StaticResource Error}"/>
        <Setter Property="BorderBrush" Value="#E8A0A0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#1AC0392B"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#26C0392B"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 输入框 ===================== -->
    <Style x:Key="BaseTextBoxStyle" TargetType="TextBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderPrimary}"/>
        <Setter Property="BorderThickness" Value="0.8"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush" Value="{StaticResource BrandPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="#B4B1AB"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                            <Setter TargetName="border" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#26E8743B" BlurRadius="2" ShadowDepth="0"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                            <Setter Property="Foreground" Value="#BBBBBB"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 待办复选框（便签内联，随便签配色） =====================
         14×14、4px 圆角、可点击区域向外扩 4px。
         描边与填充取「便签文字色」（NoteForeground）保证与每张便签的色系自洽；
         完成态为实心填充 + 白色对勾，未完成态为透明底 + 同色描边。
         ⚠️ 注意：完成时不要降整行透明度（会连同复选框一起糊掉），
         只让文字变淡 + 删除线，见 NoteWindow.xaml / NoteListView.xaml 的 DataTemplate.Triggers。

         ⚠️ 描边/填充色的来源是 ItemsControl 祖先的 DataContext.NoteForeground。
            独立便签窗口的祖先 DataContext 是 NoteWindowViewModel，
            主页编辑区的是 NotePreviewViewModel —— **两者都必须提供 NoteForeground**，
            否则绑定静默失败、BorderBrush 为空 → 复选框彻底不可见（只剩透明底）。
            样式里另外给了 FallbackValue，即使绑定再出意外也仍有可见描边。 -->
    <Style x:Key="TodoCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="14"/>
        <Setter Property="Height" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Foreground" Value="#444444"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- 外层 Grid 扩大命中区域，避免 14px 太小不好点 -->
                    <Grid Background="Transparent" Margin="-4">
                        <!-- 缩放宿主：勾选时做一个短促的「弹一下」，让完成动作有反馈。
                             幅度小、时长 80ms 且 AutoReverse，因此在快速勾选时也不会显得拖沓。 -->
                        <Grid x:Name="ScaleHost" Width="14" Height="14"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="PopScale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Box"
                                    CornerRadius="4"
                                    Background="Transparent"
                                    BorderThickness="1.3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush"
                                                Value="{Binding DataContext.NoteForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=#444444, TargetNullValue=#444444}"/>
                                    </Style>
                                </Border.Style>
                                <Path x:Name="Check"
                                      Data="M 2.5,7.5 L 5.8,10.8 L 11.5,4.5"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="14" Height="14" Stretch="None"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="Hidden"/>
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- 完成态：实心填充 + 白勾 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PopScale"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.3" Duration="0:0:0.08" AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="PopScale"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.3" Duration="0:0:0.08" AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Setter TargetName="Box" Property="Background"
                                    Value="{Binding DataContext.NoteForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}, FallbackValue=#444444, TargetNullValue=#444444}"/>
                            <Setter TargetName="Box" Property="Opacity" Value="0.95"/>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- 悬停：未完成时给一点底色提示 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Opacity" Value="1"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsChecked" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Box" Property="Background" Value="#14000000"/>
                            <Setter TargetName="Box" Property="Opacity" Value="1"/>
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 开关（ToggleSwitch，基于 CheckBox） ===================== -->
    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="20">
                        <Border x:Name="Track" Background="#CCCCCC" CornerRadius="10"/>
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"
                                 Margin="3,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrandPrimary}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== 右键上下文菜单（便签窗口「更多」菜单与托盘菜单共用） ===================== -->
    <!-- 菜单容器：白底、BorderPrimary 边框、6px 圆角 -->
    <Style x:Key="NoteContextMenuStyle" TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Margin="6" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderPrimary}"
                            BorderThickness="1" CornerRadius="6" Padding="4">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.2"/>
                        </Border.Effect>
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 菜单项：高 28px、水平内边距 12px、悬停 rgba(232,116,59,0.08)、图标 14、文字 11.5、右侧子菜单箭头、✓ 勾选 -->
    <Style x:Key="NoteMenuItemStyle" TargetType="MenuItem">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid>
                        <!-- 子菜单弹窗（颜色/透明度） -->
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Right"
                               HorizontalOffset="2" VerticalOffset="-2" Focusable="False"
                               PopupAnimation="Fade"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Margin="6" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderPrimary}"
                                    BorderThickness="1" CornerRadius="6" Padding="4">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.2"/>
                                </Border.Effect>
                                <ItemsPresenter/>
                            </Border>
                        </Popup>

                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Margin="0,1" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 图标 -->
                                <ContentPresenter x:Name="Icon" Grid.Column="0" ContentSource="Icon"
                                                  Width="14" Height="14"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- 标题 -->
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left"
                                                  Margin="0,0,8,0" RecognizesAccessKey="True"/>

                                <!-- 勾选标记 ✓ -->
                                <Path x:Name="CheckMark" Grid.Column="2" Data="M 2,8 L 5.5,11 L 12,4"
                                      Stroke="{StaticResource BrandPrimary}" StrokeThickness="1.6"
                                      Width="12" Height="12" Stretch="Uniform"
                                      VerticalAlignment="Center" Margin="12,0,0,0"
                                      Visibility="Collapsed"/>

                                <!-- 子菜单箭头 -->
                                <Path x:Name="Arrow" Grid.Column="3" Data="M 3,3 L 8,6.5 L 3,10"
                                      Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.2"
                                      Width="6" Height="10" Stretch="Fill"
                                      VerticalAlignment="Center" Margin="8,0,0,0"
                                      Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#14E8743B"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource TextPlaceholder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 分隔线 -->
    <Style x:Key="NoteMenuSeparatorStyle" TargetType="Separator">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource BorderLight}"/>
        <Setter Property="Margin" Value="8,3"/>
    </Style>

    <!-- ===================== 下拉框：圆角样式 ===================== -->
    <Style x:Key="RoundedComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="#D4D1CB"/>
        <Setter Property="BorderThickness" Value="0.8"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="10,7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="border" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#1AE8743B"/>
                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource BrandPrimary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="border"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                            CornerRadius="8"
                                            SnapsToDevicePixels="True">
                                        <Path Data="M 0,0 L 4,5 L 8,0" Width="8" Height="6" Stretch="Uniform"
                                              Stroke="#666666" StrokeThickness="1.5" Fill="Transparent"
                                              HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="BorderBrush" Value="#B4B1AB"/>
                                            <Setter TargetName="border" Property="Background" Value="#FCFBF9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="10,0,28,0"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          IsHitTestVisible="False"/>
                        <Popup x:Name="Popup"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                            <Border x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="8"
                                    Background="{DynamicResource BgCard}"
                                    BorderBrush="#D4D1CB"
                                    BorderThickness="0.8"
                                    Margin="0,4,0,0"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="0" Opacity="0.15"/>
                                </Border.Effect>
                                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 图片附件（缩略图条） ============================
         便签窗口与主页编辑区共用这一套样式，也共用同一个 AttachmentCollection 组件。
         之所以把样式集中在这里而不是各写一份：这个项目已经吃过
         「两处重复实现、改一处漏一处」的亏，附件这种"先做便签窗口、再补主页"的
         功能最容易漏第二处。集中一份，两边引用同一个 Key，从源头避免分叉。

         缩略图条本身只在有图片时出现（Visibility 绑 AttachmentCollection.Visibility），
         所以留白问题不需要调用方操心。 -->

    <!-- 单张缩略图：72×72 圆角方块，悬停时边框变亮、右下角淡出删除按钮。 -->
    <Style x:Key="AttachmentThumbStyle" TargetType="Border">
        <Setter Property="Width" Value="72"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="#14000000"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderLight}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 缩略图右下角的删除按钮：默认半透明，鼠标进入缩略图才完全显现。 -->
    <Style x:Key="AttachmentDeleteButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Opacity" Value="0.55"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="Margin" Value="0,0,3,3"/>
        <Setter Property="ToolTip" Value="移除这张图片"/>
        <Setter Property="AutomationProperties.Name" Value="移除图片"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="9" Background="#99000000">
                        <Path Data="{StaticResource IconClose}"
                              Width="8" Height="8" Stretch="Uniform"
                              Stroke="White" StrokeThickness="1.6" Fill="Transparent"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#CC000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 缩略图条容器：横向排列、不换行、超高时横向滚动；图片多时不会把便签撑高。 -->
    <Style x:Key="AttachmentStripStyle" TargetType="ItemsControl">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>

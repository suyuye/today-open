    <!-- 归档盒 -->
    <Geometry x:Key="IconArchive">M 2.5,5.5 L 13.5,5.5 M 3.5,5.5 L 3.5,13.5 L 12.5,13.5 L 12.5,5.5 M 3.5,9 L 12.5,9 M 6.5,3.5 L 9.5,3.5 L 9.5,5.5 L 6.5,5.5</Geometry>


    <!-- 折叠（向上箭头） -->
    <Geometry x:Key="IconCollapse">M 3,9.5 L 8,4.5 L 13,9.5</Geometry>

    <!-- 展开（向下箭头） -->
    <Geometry x:Key="IconExpand">M 3,6.5 L 8,11.5 L 13,6.5</Geometry>


<Window x:Class="NoteApp.Views.ReminderPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Width="320" Height="280"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Title="设置提醒"
        Icon="/Note.App;component/Assets/app.ico"
        FontFamily="{StaticResource BaseFontFamily}"
        FontSize="12.5"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 标题栏关闭按钮（红色悬停） -->
        <Style x:Key="PickerCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AC0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 字段标签 -->
        <Style x:Key="PickerLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="12" Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0.8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏（可拖拽移动） -->
            <Border Grid.Row="0" Background="Transparent" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <TextBlock Text="设置提醒" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimary}"
                               VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Style="{StaticResource PickerCloseButtonStyle}" ToolTip="关闭" AutomationProperties.Name="关闭"
                            Command="{Binding CancelCommand}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2" Fill="Transparent"/>
                    </Button>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Row="1" Margin="20,12,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 日期 -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="日期" Style="{StaticResource PickerLabelStyle}"/>
                <DatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding SelectedDate}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,12" FontSize="12"/>

                <!-- 时间 -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="时间" Style="{StaticResource PickerLabelStyle}"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <ComboBox Width="80" FontSize="12"
                              ItemsSource="{Binding Hours}" SelectedItem="{Binding SelectedHour}"/>
                    <TextBlock Text=":" VerticalAlignment="Center" Margin="8,0" Foreground="{DynamicResource TextSecondary}"/>
                    <ComboBox Width="80" FontSize="12"
                              ItemsSource="{Binding Minutes}" SelectedItem="{Binding SelectedMinute}"/>
                </StackPanel>

                <!-- 重复 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="重复" Style="{StaticResource PickerLabelStyle}"/>
                <ComboBox Grid.Row="2" Grid.Column="1" FontSize="12"
                          ItemsSource="{Binding RepeatOptions}" DisplayMemberPath="Display"
                          SelectedValuePath="Value" SelectedValue="{Binding SelectedRepeatRule}"/>
            </Grid>

            <!-- 底部：提示 + 按钮 -->
            <StackPanel Grid.Row="2" Margin="20,0,20,16">
                <TextBlock Text="提醒时间已过，请选择未来时间" FontSize="11"
                           Foreground="{StaticResource Error}" Margin="0,10,0,0"
                           Visibility="{Binding IsPastTime, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Content="取消" Style="{StaticResource BaseButtonStyle}"
                            Command="{Binding CancelCommand}" Width="72" Height="30"/>
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Width="72" Height="30" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>

<Window x:Class="NoteApp.Views.NoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NoteApp.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        SizeToContent="Manual"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="{Binding IsPinned}"
        Opacity="{Binding WindowOpacity}"
        Background="Transparent"
        Title="便签"
        Icon="/Note.App;component/Assets/app.ico"
        Width="220" Height="200"
        MinWidth="180" MinHeight="120"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 便签文字色 → 同色相半透明底：折叠态待办徽标的底色由此派生，
             保证「长在便签上的元素颜色都能从这张便签自己身上找到出处」。 -->
        <helpers:AlphaColorConverter x:Key="AlphaColor"/>

        <!-- ===================== 纸张质感（纯 WPF 绘制，不依赖系统材质） =====================
             思路：便签的隐喻是「纸」，但纯色块看起来像塑料卡片。
             下面三个画刷都是**半透明叠加**，因此能跟 12 种便签底色自然融合，
             不需要为每种颜色各配一套纹理。
             之所以不用 Mica/Acrylic：便签窗口用了 AllowsTransparency（分层窗口），
             与 DWM 系统背景互斥，且系统材质在 Win10 上不可用。 -->

        <!-- 纸纤维：极淡的不规则短划线平铺。
             只画 1.5% 左右的黑，放大看是细微颗粒，正常距离下只表现为「不光滑」。
             密度刻意做得很低 —— 纸张纹理一旦看得清就变脏了。

             为什么是 24×24 而不是小尺寸：早先试过 6×6，
             实测自相关在 lag=18（即 6 的整数倍）出现 0.98 的强峰，
             说明小 tile 会形成肉眼可辨的规则网格，看着像「布纹/网纱」而不是纸。
             现在把 tile 放大到 24×24，并且刻意让短划线都偏离网格交点、
             长度方向互相错开，自相关峰值随之被打散，重复感基本消失。 -->
        <DrawingBrush x:Key="PaperFiberBrush" TileMode="Tile"
                      Viewport="0,0,24,24" ViewportUnits="Absolute"
                      Viewbox="0,0,24,24" ViewboxUnits="Absolute"
                      Stretch="Fill" Opacity="0.5">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <!-- 三档浓度错开用（0x08 / 0x0A / 0x0C），
                         避免所有纤维同等强度而产生「花纹」的规整感。 -->
                    <GeometryDrawing Brush="#08000000">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="1.7,2.3,3.1,0.9"/>
                                <RectangleGeometry Rect="13.4,5.9,2.6,0.8"/>
                                <RectangleGeometry Rect="19.2,17.4,3.3,0.9"/>
                                <RectangleGeometry Rect="6.1,20.2,2.4,0.8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0A000000">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="8.9,1.1,2.2,0.7"/>
                                <RectangleGeometry Rect="4.3,12.6,3.4,0.9"/>
                                <RectangleGeometry Rect="16.1,23.1,2.5,0.8"/>
                                <RectangleGeometry Rect="21.3,9.2,2.0,0.7"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#0C000000">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="11.2,16.8,3.0,1.0"/>
                                <RectangleGeometry Rect="0.8,15.1,2.7,0.8"/>
                                <RectangleGeometry Rect="17.6,2.8,2.3,0.9"/>
                                <RectangleGeometry Rect="9.6,8.4,2.9,0.8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 上方光照：顶部一点暖白，往下 120px 内淡出。
             模拟光源在上方，纸面有轻微的明暗过渡，纯平的色块因此获得体感。 -->
        <LinearGradientBrush x:Key="PaperLightBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#14FFFFFF" Offset="0"/>
            <GradientStop Color="#06FFFFFF" Offset="0.55"/>
            <GradientStop Color="#00000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- 纸边厚度：顶部微亮、底部微暗。
             真实纸张边缘有纤维堆积，会形成一圈极淡的立体描边；
             这层让便签看起来是「一张有厚度的纸」而不是「一个填充矩形」。
             亮/暗都压在两端 5% 以内，中间完全透明 —— 否则会像加了内边框。 -->
        <LinearGradientBrush x:Key="PaperEdgeBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#18FFFFFF" Offset="0"/>
            <GradientStop Color="#00000000" Offset="0.05"/>
            <GradientStop Color="#00000000" Offset="0.94"/>
            <GradientStop Color="#10000000" Offset="1"/>
        </LinearGradientBrush>

        <!-- 锁定斜纹遮罩（45° 斜线）。
             原来整体透明度 3%，实际几乎看不见，锁定与未锁定在视觉上没差别。
             提到 7% 后可感知但仍不影响阅读，配合顶部锁定提示条形成明确的「锁定」语义。 -->
        <VisualBrush x:Key="LockStripeBrush" TileMode="Tile"
                     Viewport="0,0,8,8" ViewportUnits="Absolute"
                     Viewbox="0,0,8,8" ViewboxUnits="Absolute">
            <VisualBrush.Visual>
                <Path Data="M 0,8 L 8,0" Stroke="Black" StrokeThickness="1.2"/>
            </VisualBrush.Visual>
        </VisualBrush>

        <!-- 缩放手柄（透明，覆盖窗口边缘 6px；右下角另行画斜线图标） -->
        <Style x:Key="ResizeThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏图标按钮（普通） -->
        <Style x:Key="NoteTitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#0F000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1F000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏关闭按钮（红色悬停） -->
        <Style x:Key="NoteCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource NoteTitleBarButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1AC0392B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#26C0392B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 根 Grid：Border 承载视觉内容，Thumb 承载八向缩放（位于透明阴影边距内，不遮挡内容区）。 -->
    <Grid>
        <!-- 外层 Border：圆角 + 阴影。Margin 给 DropShadowEffect 留出渲染空间（对应 code-behind 的 ShadowMargin）。 -->
        <Border Margin="12" ClipToBounds="True"
                BorderBrush="{Binding NoteBorderBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="{Binding NoteCornerRadius}"/>
                    <Setter Property="BorderThickness" Value="{Binding NoteBorderThickness}"/>
                    <Setter Property="Background" Value="{Binding NoteBackground}"/>
                    <Style.Triggers>
                        <!-- 折叠态：无边框、背景与标题栏一致，确保胶囊上下圆角弧度一致 -->
                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="{Binding NoteTitleBackground}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <!-- 阴影色跟随便签色相（暖色），不再是统一的纯黑。
                     纯黑阴影压在彩色纸上会让边缘发脏灰，像蹭了一圈煤；
                     同色相的深色阴影才有「纸从桌面浮起来」的干净感。
                     透明度和模糊半径保持不变，避免改变已有的立体量级。 -->
                <DropShadowEffect x:Name="NoteShadow" Color="{Binding NoteShadowColor}" BlurRadius="8" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>

            <!-- 分两层：底层纸张质感，上层原有内容。
                 质感层 IsHitTestVisible=False，完全不参与命中测试，
                 避免影响现有的自绘选区、拖拽、缩放手柄等交互。 -->
            <Grid>
                <!-- 纸张质感层（折叠态隐藏：折叠后只剩一条胶囊，纹理没有意义且会显脏） -->
                <Grid IsHitTestVisible="False" ClipToBounds="True"
                      Visibility="{Binding ContentVisibility}">
                    <Rectangle Fill="{StaticResource PaperLightBrush}"/>
                    <Rectangle Fill="{StaticResource PaperFiberBrush}"/>
                    <Rectangle Fill="{StaticResource PaperEdgeBrush}"/>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition>
                            <RowDefinition.Style>
                                <Style TargetType="RowDefinition">
                                    <Setter Property="Height" Value="28"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMinimal}" Value="True">
                                            <Setter Property="Height" Value="0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                            <Setter Property="Height" Value="32"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RowDefinition.Style>
                        </RowDefinition>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题栏（可拖拽移动窗口；极简模式隐藏；折叠态全圆角胶囊形） -->
                    <Border x:Name="TitleBar" Grid.Row="0"
                            Background="{Binding NoteTitleBackground}"
                            Visibility="{Binding TitleBarVisibility}"
                            MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">                    <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8,8,0,0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                        <Setter Property="CornerRadius" Value="12,12,12,12"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 折叠态语义色脊：折叠成胶囊后便签底色被标题栏色取代，
                                 这张纸「是什么颜色」的信息会丢失。左侧留一道便签描边色的
                                 细脊，既守住颜色身份，又像书脊一样给出「这是一张便签」的暗示。
                                 展开态不需要（那时四周都有便签底色），故仅折叠时可见。 -->
                            <Rectangle Grid.Column="0" Width="3" RadiusX="1.5" RadiusY="1.5"
                                       Margin="6,7"
                                       Fill="{Binding NoteAccentBrush}"
                                       Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVis}}"/>

                            <!-- 置顶橙色竖条 -->
                            <Rectangle Grid.Column="1" Width="3" RadiusX="1.5" RadiusY="1.5" Margin="0,6"
                                       Fill="{StaticResource BrandPrimary}"
                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"/>

                            <!-- 标题 + 锁图标 + 标题编辑框 -->
                            <Grid Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IconLock}" Width="11" Height="11" Stretch="Uniform"
                                          StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,4,0"
                                          Stroke="{DynamicResource TextSecondary}" Fill="Transparent"
                                          Visibility="{Binding LockIconVisibility}"/>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="{Binding NoteTitleFontSize}" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding NoteForeground}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="TextTrimming" Value="None"/>
                                                <Style.Triggers>
                                                    <!-- 仅折叠态（且非编辑态）显示标题；展开态标题栏不显示 Title -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsCollapsed}" Value="True"/>
                                                            <Condition Binding="{Binding IsEditingTitle}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                        <Setter Property="Opacity" Value="0.7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 折叠态未完成待办徽标：折叠后看不到内容，
                                         这个数字是唯一的进度提示（有几件事还没做完）。
                                         只统计未完成项；全部完成时不显示，避免挂个 0 碍眼。

                                         曾经是「橙色实心圆 + 白色数字」，三个问题：
                                         ① 橙色是品牌色，长在便签上跟这张纸没有任何关系，违反色彩自洽；
                                         ② 裸数字看着像 App 的未读通知，读不出「这是待办」；
                                         ③ 与标题文字只隔 6px，粘在一起像标题的一部分。
                                         现在改为「勾选框图标 + 数字」，并按便签文字色着色：
                                         图标用 NoteForeground（实线），数字用 NoteForeground 的 78% 淡一档，
                                         既守住色系，又能一眼分辨「待办」而不是「未读消息」。 -->
                                    <Border CornerRadius="7" Margin="10,0,0,0" Padding="6,0,8,0"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Background="{Binding NoteForegroundColor, Converter={StaticResource AlphaColor}, ConverterParameter=11}"
                                            Visibility="{Binding TodoBadgeVisibility}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource IconTodoBadge}"
                                                  Width="10" Height="10" Stretch="Uniform"
                                                  StrokeThickness="1.7"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stroke="{Binding NoteForeground}"
                                                  Fill="Transparent"
                                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding UncheckedTodoCount}"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{Binding NoteForeground}"
                                                       Opacity="0.78"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 标题编辑框（编辑模式显示，覆盖标题位置） -->
                                <TextBox x:Name="TitleEditBox"
                                         Text="{Binding EditingTitleText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding IsEditingTitle, Converter={StaticResource BoolToVis}}"
                                         FontSize="{Binding NoteTitleFontSize}" FontWeight="SemiBold"
                                         Foreground="{Binding NoteForeground}"
                                         Background="{Binding NoteTitleBackground}"
                                         BorderBrush="{Binding NoteBorderBrush}" BorderThickness="0.8"
                                         Padding="4,1" VerticalContentAlignment="Center" MaxLength="50">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding SaveTitleCommand}"/>
                                        <KeyBinding Key="Escape" Command="{Binding CancelEditTitleCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>

                            <!-- 控制按钮：折叠按钮始终显示；更多/置顶/关闭默认隐藏、鼠标进入标题栏淡入，折叠态整体隐藏 -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                                <!-- 更多 / 置顶 / 关闭（折叠态仅保留折叠按钮，此处整体隐藏） -->
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=TitleBar}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <!-- 提醒 -->
                                    <Button Style="{StaticResource NoteTitleBarButtonStyle}" ToolTip="设置提醒" AutomationProperties.Name="设置提醒"
                                            Click="ReminderButton_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Data" Value="{StaticResource IconBell}"/>
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                    <Setter Property="StrokeThickness" Value="1.2"/>
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasReminder}" Value="True">
                                                            <Setter Property="Data" Value="{StaticResource IconBellActive}"/>
                                                            <Setter Property="Stroke" Value="Transparent"/>
                                                            <Setter Property="Fill" Value="{StaticResource BrandPrimary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                    <!-- 待办 -->
                                    <Button Style="{StaticResource NoteTitleBarButtonStyle}" ToolTip="待办事项" AutomationProperties.Name="待办事项"
                                            Click="TodoButton_Click">
                                        <Path Width="14" Height="14" Stretch="Uniform"
                                              Data="M3 3h18v18H3V3zm2 2v14h14V5H5zm2.5 4.5l2 2 4-4"
                                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.2" Fill="Transparent"/>
                                    </Button>

                                    <!-- 更多 -->
                                    <Button Style="{StaticResource NoteTitleBarButtonStyle}" ToolTip="更多" AutomationProperties.Name="更多"
                                            Click="MoreButton_Click">
                                        <Path Data="{StaticResource IconMore}" Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondary}"/>
                                    </Button>

                                    <!-- 锁定 -->
                                    <Button Style="{StaticResource NoteTitleBarButtonStyle}" ToolTip="锁定" AutomationProperties.Name="锁定"
                                            Command="{Binding ToggleLockCommand}">
                                        <Path Data="{StaticResource IconLock}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}"/>
                                                            <Setter Property="Fill" Value="{StaticResource BrandPrimary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                    <!-- 置顶 -->
                                    <Button Style="{StaticResource NoteTitleBarButtonStyle}" ToolTip="置顶" AutomationProperties.Name="置顶"
                                            Command="{Binding TogglePinCommand}">
                                        <Path Data="{StaticResource IconPin}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource BrandPrimary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>

                                    <!-- 关闭 -->
                                    <Button Style="{StaticResource NoteCloseButtonStyle}" ToolTip="关闭" AutomationProperties.Name="关闭"
                                            Command="{Binding CloseCommand}">
                                        <Path Data="{StaticResource IconClose}" Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.2">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                    <Setter Property="Fill" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                                                            <Setter Property="Stroke" Value="{StaticResource Error}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Button>
                                </StackPanel>

                                <!-- 折叠 / 展开（始终显示，折叠态为唯一可见按钮） -->
                                <Button Style="{StaticResource NoteTitleBarButtonStyle}" ToolTip="折叠 / 展开" AutomationProperties.Name="折叠 / 展开"
                                        Command="{Binding ToggleCollapseCommand}">
                                    <Path Width="14" Height="14" Stretch="Uniform">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Data" Value="{StaticResource IconCollapse}"/>
                                                <Setter Property="Stroke" Value="{DynamicResource TextSecondary}"/>
                                                <Setter Property="StrokeThickness" Value="1.2"/>
                                                <Setter Property="Fill" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                                        <Setter Property="Data" Value="{StaticResource IconExpand}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 内容编辑区（自动保存防抖见 NoteWindowViewModel；折叠时隐藏） -->
                    <Grid Grid.Row="1"
                          Visibility="{Binding ContentVisibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 展开状态标题输入框（极简模式隐藏） -->
                        <TextBox x:Name="TitleTextBox" Grid.Row="0"
                                 Text="{Binding EditableTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Visibility="{Binding TitleBarVisibility}"
                                 FontSize="{Binding NoteTitleFontSize}" FontWeight="SemiBold"
                                 FontFamily="{Binding NoteFontFamily}"
                                 Foreground="{Binding NoteForeground}"
                                 BorderThickness="0" Background="Transparent"
                                 Padding="12,8,12,2"
                                 VerticalContentAlignment="Center"/>

                        <!-- 标题与内容分隔线（极简模式隐藏；锁定时让位给下方锁定条） -->
                        <Border Grid.Row="0" Height="1" Background="#0F000000" VerticalAlignment="Bottom" Margin="12,0"
                                Visibility="{Binding TitleBarVisibility}"/>

                        <!-- 锁定提示条：仅锁定时出现。
                             之前锁定只有一层几乎看不见的斜纹和状态栏三个字，
                             用户看不出「这是一张被刻意锁住的便签」还是「界面坏了」。
                             这里给一段明确的说明 + 就地解锁入口，让锁定成为一个可理解的状态。 -->
                        <Border Grid.Row="1" Padding="12,7" Background="#14000000"
                                Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{StaticResource IconLock}"
                                      Width="12" Height="12" Stretch="Uniform"
                                      StrokeThickness="1.2" VerticalAlignment="Center" Margin="0,0,6,0"
                                      Stroke="{Binding NoteForeground}" Fill="Transparent"/>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                           FontSize="10.5" Opacity="0.75"
                                           Text="已锁定，内容不可编辑"
                                           Foreground="{Binding NoteForeground}"/>
                                <Button Grid.Column="2" Content="解锁"
                                        FontSize="10.5" Padding="7,1" Cursor="Hand"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding NoteForeground}"
                                        Command="{Binding ToggleLockCommand}">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderBrush" Value="{Binding NoteBorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#12000000"/>
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#22000000"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 图片缩略图条：没有图片时整条 Collapsed（不占位）。
                             用 AttachmentCollection.Visibility 控制显隐，见 Styles.xaml 的说明。 -->
                        <ItemsControl Grid.Row="2"
                                      Style="{StaticResource AttachmentStripStyle}"
                                      ItemsSource="{Binding Attachments.Items}"
                                      Visibility="{Binding Attachments.Visibility}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource AttachmentThumbStyle}" ToolTip="{Binding Description}">
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                        </Border>
                                        <Button Style="{StaticResource AttachmentDeleteButtonStyle}"
                                                Command="{Binding DeleteCommand}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 内容区：按行渲染，支持待办事项复选框 + 完成删除线 -->
                        <ScrollViewer x:Name="ContentBox" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" Padding="{Binding ContentPadding}"
                                      MouseDoubleClick="ContentBox_MouseDoubleClick"
                                      PreviewMouseLeftButtonDown="ContentBox_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="ContentBox_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="ContentBox_PreviewMouseLeftButtonUp">
                            <ScrollViewer.Resources>
                                <!-- 细滚动条：与便签纸张视觉一致（窄轨道、圆角半透明滑块） -->
                                <Style TargetType="ScrollBar">
                                    <Setter Property="Width" Value="8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollBar">
                                                <Grid Background="Transparent">
                                                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Border x:Name="ThumbBg" Width="5" Height="{TemplateBinding Height}"
                                                                                HorizontalAlignment="Center" CornerRadius="2.5"
                                                                                Background="#26000000"/>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="ThumbBg" Property="Background" Value="#40000000"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsDragging" Value="True">
                                                                                <Setter TargetName="ThumbBg" Property="Background" Value="#59000000"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ScrollViewer.Resources>
                            <ItemsControl x:Name="ContentItemsControl" ItemsSource="{Binding Lines}"
                                          Margin="{Binding ContentBottomGap}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 待办事项复选框（仅 Todo 类型显示；样式随便签配色的文字色） -->
                                            <CheckBox Grid.Column="0" x:Name="TodoCheckBox"
                                                      Style="{StaticResource TodoCheckBoxStyle}"
                                                      IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                      VerticalAlignment="Center" VerticalContentAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Padding="0" Margin="0,0,6,0"
                                                      Visibility="Collapsed"
                                                      Cursor="Hand"/>

                                            <!-- 行文本编辑框（跨行选区高亮：非聚焦也显示选中态） -->
                                            <TextBox Grid.Column="1" x:Name="LineTextBox"
                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent" BorderThickness="0"
                                                     FontSize="{Binding DataContext.NoteFontSize, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     FontFamily="{Binding DataContext.NoteFontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                     TextWrapping="Wrap" AcceptsReturn="False" AcceptsTab="False"
                                                     VerticalContentAlignment="Center" Padding="0"
                                                     Cursor="IBeam"
                                                     IsInactiveSelectionHighlightEnabled="True"
                                                     SelectionBrush="{StaticResource BrandPrimary}" SelectionOpacity="0.25"
                                                     PreviewKeyDown="LineTextBox_KeyDown"
                                                     PreviewTextInput="LineTextBox_TextInput"
                                                     PreviewMouseLeftButtonDown="LineTextBox_MouseLeftButtonDown"
                                                     PreviewMouseMove="LineTextBox_MouseMove"
                                                     PreviewMouseLeftButtonUp="LineTextBox_MouseUp"
                                                     Loaded="LineTextBox_Loaded">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="Foreground" Value="{Binding DataContext.NoteForeground, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                        <!-- 行高 1.5：正文信息密度高，1.35 会显得挤。
                                                             ⚠️ LineHeight 是 TextBlock 的属性，TextBox 没有；
                                                             必须写成 TextBlock.LineHeight 附加属性，再让模板内的
                                                             文本宿主继承下去。实测 16.5 字号可精确得到 24.75 行高。 -->
                                                        <Setter Property="TextBlock.LineHeight" Value="{Binding DataContext.NoteLineHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                        <Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight"/>
                                                        <Style.Triggers>
                                                            <!-- 锁定时光标变为 Arrow -->
                                                            <DataTrigger Binding="{Binding DataContext.IsLocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="Cursor" Value="Arrow"/>
                                                                <Setter Property="IsReadOnly" Value="True"/>
                                                            </DataTrigger>
                                                            <!-- 低透明度时文字强制黑色 -->
                                                            <DataTrigger Binding="{Binding DataContext.IsLowOpacity, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                <Setter Property="Foreground" Value="Black"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </Grid>

                                        <!-- 根据行类型显示/隐藏复选框；待办完成时只淡文字 + 删除线，复选框保持清晰 -->
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding LineType}" Value="Todo">
                                                <Setter TargetName="TodoCheckBox" Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding LineType}" Value="Todo"/>
                                                    <Condition Binding="{Binding IsChecked}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <!-- 只作用于文字：降不透明度 + 删除线。整行降透明度会让复选框一起糊掉 -->
                                                <Setter TargetName="LineTextBox" Property="Opacity" Value="0.45"/>
                                                <Setter TargetName="LineTextBox" Property="TextDecorations" Value="Strikethrough"/>
                                            </MultiDataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- 锁定斜纹遮罩（7% 透明度，不拦截鼠标；配合上方锁定提示条形成明确语义） -->
                        <Rectangle Grid.Row="3" Fill="{StaticResource LockStripeBrush}" Opacity="0.07"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- 底部状态栏 -->
                    <Border Grid.Row="2" Height="28" CornerRadius="0,0,8,8"
                            Visibility="{Binding StatusBarVisibility}"
                            Background="{Binding NoteTitleBackground}">
                        <!-- 字数与相对时间并排靠左：右下角是卷角的位置，
                             相对时间原来靠右会被折角压住，移到左边与字数并列即可避开。
                             两者之间用一句「·」轻分隔，读起来仍是一行状态信息。 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="10,0" >
                            <TextBlock VerticalAlignment="Center" FontSize="10.5" Opacity="0.7"
                                       Text="{Binding WordCount, StringFormat={}{0} 字}"
                                       Foreground="{Binding NoteForeground}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="10.5" Opacity="0.35"
                                       Margin="6,0"
                                       Text="·"
                                       Foreground="{Binding NoteForeground}"/>
                            <TextBlock VerticalAlignment="Center" FontSize="10.5" Opacity="0.7"
                                       Text="{Binding RelativeUpdateTime}"
                                       Foreground="{Binding NoteForeground}"/>
                        </StackPanel>
                    </Border>

                    <!-- 提醒闪烁橙色边框（覆盖整个窗口，极简模式下仍生效） -->
                    <Border x:Name="FlashBorder" Grid.RowSpan="3" CornerRadius="{Binding NoteCornerRadius}"
                            BorderBrush="{StaticResource BrandPrimary}" BorderThickness="2"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>

                <!-- ============ 卷角（右下角翻折纸角）============
                     纯装饰，IsHitTestVisible=False，不参与任何命中测试（不能挡住右下角的缩放手柄）。
                     隐喻：这张纸被人掀起了右下角，露出纸的背面。

                     尺寸用 VM 的 DogEarSize（22），用 Grid 右下对齐 + 显式宽高摆放，
                     比 Canvas 附加属性更稳（不依赖父容器测量顺序）。

                     分两块叠：
                       ① 折痕阴影：沿折线铺一层压暗渐变，制造"掀起来"的厚度投射；
                       ② 折角亮面：翻过来的那面，比便签底色更亮（背面朝光），带同源描边。

                     颜色全部由 VM 从这张便签自己的底色派生（DogEarFaceBrush），
                     不引入任何外部色，跟 12 种便签底色都能自然融合 —— 与"颜色自洽"约定一致。 -->
                <Grid IsHitTestVisible="False"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Width="{Binding DogEarSize}" Height="{Binding DogEarSize}"
                      Visibility="{Binding DogEarVisibility}">
                    <!-- ① 折痕阴影：紧贴折线（斜边）外侧的一条窄带，朝外淡出。
                         先画它，让随后的折角亮面盖在它的下方区域上。
                         几何：斜边 (0,22)-(22,0) 往左上平移 8px 得到外沿，
                         形成一个沿折线的四边形窄带；渐变自折线(不透明)向外(透明)。 -->
                    <Path Data="M 0,22 L 22,0 L 6.5,0 L 0,6.5 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                <GradientStop Color="#3A000000" Offset="0"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- ② 折角亮面：右下角三角形，斜边朝左上（就是折线）。
                         几何写成实际尺寸，不靠 Stretch 缩放，避免单位几何 + 描边
                         在某些 DPI 下退化到不可见。 -->
                    <Path Data="M 0,22 L 22,0 L 22,22 Z"
                          Fill="{Binding DogEarFaceBrush}"
                          Stroke="{Binding NoteBorderBrush}"
                          StrokeThickness="0.9"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 贴边吸附预览（拖动时实时显示） ============
             解决的核心问题：早期版本只在松手时判定是否贴边，拖动全程界面毫无反馈，
             用户根本不知道"这个位置松手会不会吸"，只能靠反复试 —— 主观感受就是
             "很难找到那个刚刚好的距离"。

             现在拖到距边缘一定范围内，就近的那一侧会亮起一条琥珀色竖条 + 一句提示，
             明确告诉用户"松手会贴上去"。提示只在拖动期间出现，静止时不占视觉。

             IsHitTestVisible=False：绝不能干扰拖拽本身。 -->
        <Grid x:Name="SnapPreviewLayer" IsHitTestVisible="False" Visibility="Collapsed">
            <!-- 左边缘高亮条 -->
            <Border x:Name="SnapBarLeft" HorizontalAlignment="Left" Width="3" Margin="12,14,0,14"
                    CornerRadius="1.5" Background="{StaticResource BrandPrimary}" Opacity="0"/>
            <!-- 右边缘高亮条 -->
            <Border x:Name="SnapBarRight" HorizontalAlignment="Right" Width="3" Margin="0,14,12,14"
                    CornerRadius="1.5" Background="{StaticResource BrandPrimary}" Opacity="0"/>

            <!-- 提示气泡：贴在将要吸附的那一侧 -->
            <Border x:Name="SnapHintLeft" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="22,0,0,0" CornerRadius="10" Padding="8,3"
                    Background="{StaticResource BrandPrimary}" Opacity="0">
                <TextBlock Text="松手贴到左边" FontSize="10.5" Foreground="White"/>
            </Border>
            <Border x:Name="SnapHintRight" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,22,0" CornerRadius="10" Padding="8,3"
                    Background="{StaticResource BrandPrimary}" Opacity="0">
                <TextBlock Text="松手贴到右边" FontSize="10.5" Foreground="White"/>
            </Border>
        </Grid>

        <!-- ============ 便签间对齐提示线（拖动时靠近别的便签才出现） ============
             拖动中靠近另一张便签、边缘齐平时，在这里画一条琥珀色细线，
             让用户看清"我跟哪条边对齐了"。
             线只画在本窗口范围内：跨窗口画线要额外的覆盖层，收益有限；
             用户看到"我这里有条线跟对方齐平"就足以理解发生了什么。
             IsHitTestVisible=False：绝不能干扰拖拽。 -->
        <Grid x:Name="AlignGuideLayer" IsHitTestVisible="False">
            <!-- 竖线：横向对齐（左对左 / 右对右）时显示，位置由 code-behind 设 Margin.Left -->
            <Border x:Name="AlignGuideVertical" Width="1"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Background="#E8902A" Opacity="0.9" Visibility="Collapsed"/>
            <!-- 横线：纵向对齐（上对上 / 下对下）时显示，位置由 Margin.Top 决定 -->
            <Border x:Name="AlignGuideHorizontal" Height="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Top"
                    Background="#E8902A" Opacity="0.9" Visibility="Collapsed"/>
        </Grid>

        <!-- ============ 框选高亮（被框选批量拖动时显示） ============
             只在桌面框选命中时出现，套在便签可见内容外圈。
             用独立的琥珀色描边而不是改便签底色：便签颜色是用户选的，
             不该被临时的"选中"状态覆盖掉。
             与贴边提示同色系，让"选中"这件事在同一套视觉语言里。
             IsHitTestVisible=False：绝不干扰鼠标（框选判定全部来自全局钩子）。 -->
        <Border x:Name="MarqueeHighlight"
                Margin="12" CornerRadius="{Binding NoteCornerRadius}"
                BorderBrush="#E8902A" BorderThickness="2"
                IsHitTestVisible="False" Visibility="Collapsed"/>

        <!-- 四边缩放手柄（透明 6px） -->
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="W" Cursor="SizeWE"
               HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="E" Cursor="SizeWE"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="N" Cursor="SizeNS"
               VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="6"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="S" Cursor="SizeNS"
               VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="6"
               DragDelta="ResizeThumb_DragDelta"/>

        <!-- 四角缩放手柄（透明；右下角画斜线图标） -->
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="NW" Cursor="SizeNWSE"
               HorizontalAlignment="Left" VerticalAlignment="Top" Width="12" Height="12"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="NE" Cursor="SizeNESW"
               HorizontalAlignment="Right" VerticalAlignment="Top" Width="12" Height="12"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Style="{StaticResource ResizeThumbStyle}" Tag="SW" Cursor="SizeNESW"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12"
               DragDelta="ResizeThumb_DragDelta"/>
        <Thumb Tag="SE" Cursor="SizeNWSE"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16"
               DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Path Data="M0,10 L10,0 M4,10 L10,4 M8,10 L10,8"
                              Stroke="{DynamicResource TextSecondary}" StrokeThickness="1" Opacity="0.35"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,3"
                              Width="10" Height="10" Stretch="Fill"/>
                    </Grid>
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</Window>

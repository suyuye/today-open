<Window x:Class="NoteApp.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ToastWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Opacity="0">
    <Border Background="#F5FFFFFF"
            BorderBrush="#D0D0D0"
            BorderThickness="1"
            CornerRadius="8"
            Padding="16,10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.35"/>
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="MessageText"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#333333"/>
            <Button x:Name="ActionButton"
                    Content="撤销"
                    Margin="16,0,0,0"
                    Padding="8,3"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#1A73E8"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Cursor="Hand"
                    Click="ActionButton_Click"/>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="NoteApp.Views.ReminderNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:NoteApp.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Width="320" Height="140"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Title="提醒"
        FontFamily="{StaticResource BaseFontFamily}"
        FontSize="12.5"
        Opacity="0">
    <Window.Resources>
        <helpers:NoteColorConverter x:Key="NoteColorConverter"/>
    </Window.Resources>

    <!-- 卡片：白色圆角 + 阴影 + 左侧便签颜色条；RenderTransform 用于滑入/滑出动画 -->
    <Border x:Name="CardBorder" Margin="8" CornerRadius="12" Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0.8" ClipToBounds="True">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SlideTransform" Y="24"/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧便签颜色条 -->
            <Border Grid.Column="0"
                    Background="{Binding NoteColor, Converter={StaticResource NoteColorConverter}, ConverterParameter=Border}"/>

            <!-- 内容区 -->
            <Grid Grid.Column="1" Margin="14,10,14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题（单行省略） -->
                <TextBlock Grid.Row="0" Text="{Binding NoteTitle}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis"/>

                <!-- 内容预览（两行省略） -->
                <TextBlock Grid.Row="1" Text="{Binding NotePreview}" FontSize="12"
                           Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis" MaxHeight="34" Margin="0,3,0,0"/>

                <!-- 按钮：稍后（下拉选择分钟数）/ 完成 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button x:Name="SnoozeButton" Content="稍后" Style="{StaticResource BaseButtonStyle}"
                            Width="64" Height="28" Click="SnoozeButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="5 分钟后" Tag="5" Click="SnoozeMenuItem_Click"/>
                                <MenuItem Header="10 分钟后" Tag="10" Click="SnoozeMenuItem_Click"/>
                                <MenuItem Header="30 分钟后" Tag="30" Click="SnoozeMenuItem_Click"/>
                                <MenuItem Header="1 小时后" Tag="60" Click="SnoozeMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="自定义..." Click="CustomSnoozeMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="完成" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CompleteCommand}" Width="64" Height="28" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>

<Window x:Class="NoteApp.Views.TagCreateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Width="320" Height="250"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Title="新建标签"
        FontFamily="{StaticResource BaseFontFamily}"
        FontSize="12.5"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <!-- 标签颜色色板：圆角方块，选中时显示品牌橙描边 -->
        <Style x:Key="TagColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="outer" Width="22" Height="22" CornerRadius="6"
                                BorderThickness="1.5" BorderBrush="#26000000"
                                Background="#01FFFFFF">
                            <Border x:Name="inner" CornerRadius="4" Margin="3"
                                    Background="{TemplateBinding Background}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="outer" Property="BorderBrush" Value="{StaticResource BrandPrimary}"/>
                                <Setter TargetName="outer" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outer" Property="Background" Value="#0A000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0.8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="新建标签" FontSize="13" FontWeight="SemiBold"
                       Margin="16,14,16,0" Foreground="{DynamicResource TextPrimary}"/>

            <!-- 名称输入 -->
            <StackPanel Grid.Row="1" Margin="16,12,16,0">
                <TextBlock Text="名称" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4"/>
                <TextBox x:Name="NameTextBox" Height="28" FontSize="12"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- 颜色选择：12 色分两行，每行 6 个（上行深档、下行浅档，同列同色相） -->
            <StackPanel Grid.Row="2" Margin="16,12,16,0">
                <TextBlock Text="颜色" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <RadioButton GroupName="TagColor" Tag="YellowDeep" Checked="ColorRadio_Checked" AutomationProperties.Name="深黄"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteYellowDeep_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="GreenDeep" Checked="ColorRadio_Checked" AutomationProperties.Name="深绿"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteGreenDeep_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="BlueDeep" Checked="ColorRadio_Checked" AutomationProperties.Name="深蓝"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteBlueDeep_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="PinkDeep" Checked="ColorRadio_Checked" AutomationProperties.Name="深粉"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NotePinkDeep_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="PurpleDeep" Checked="ColorRadio_Checked" AutomationProperties.Name="深紫"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NotePurpleDeep_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="GrayDeep" IsChecked="True" Checked="ColorRadio_Checked" AutomationProperties.Name="深灰"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteGrayDeep_Bg}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,6,0,0">
                    <RadioButton GroupName="TagColor" Tag="YellowLight" Checked="ColorRadio_Checked" AutomationProperties.Name="浅黄"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteYellowLight_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="GreenLight" Checked="ColorRadio_Checked" AutomationProperties.Name="浅绿"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteGreenLight_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="BlueLight" Checked="ColorRadio_Checked" AutomationProperties.Name="浅蓝"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteBlueLight_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="PinkLight" Checked="ColorRadio_Checked" AutomationProperties.Name="浅粉"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NotePinkLight_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="PurpleLight" Checked="ColorRadio_Checked" AutomationProperties.Name="浅紫"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NotePurpleLight_Bg}"/>
                    <RadioButton GroupName="TagColor" Tag="GrayLight" Checked="ColorRadio_Checked" AutomationProperties.Name="浅灰"
                                 Style="{StaticResource TagColorSwatchStyle}" Background="{StaticResource NoteGrayLight_Bg}"/>
                </StackPanel>
            </StackPanel>

            <!-- 错误提示 -->
            <TextBlock x:Name="HintText" Grid.Row="3" Text="请输入标签名称" FontSize="11"
                       Foreground="{StaticResource Error}" Margin="16,8,0,0" Visibility="Collapsed"/>

            <!-- 按钮 -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
                <Button Content="取消" Style="{StaticResource BaseButtonStyle}"
                        Click="Cancel_Click" Width="72" Height="30"/>
                <Button Content="确定" Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" Width="72" Height="30" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

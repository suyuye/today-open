<Window x:Class="NoteApp.Views.SnoozeInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Width="300" Height="150"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        Title="自定义稍后提醒"
        FontFamily="{StaticResource BaseFontFamily}"
        FontSize="12.5"
        Foreground="{DynamicResource TextPrimary}">
    <Border Margin="12" CornerRadius="12" Background="{DynamicResource BgCard}"
            BorderBrush="{DynamicResource BorderPrimary}" BorderThickness="0.8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <TextBlock Grid.Row="0" Text="自定义稍后提醒" FontSize="13" FontWeight="SemiBold"
                       Margin="16,14,16,0" Foreground="{DynamicResource TextPrimary}"/>

            <!-- 输入：分钟数 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,12,16,0">
                <TextBox x:Name="MinutesTextBox" Width="80" Height="28" FontSize="12"
                         VerticalContentAlignment="Center" TextAlignment="Right"
                         PreviewTextInput="MinutesTextBox_PreviewTextInput"/>
                <TextBlock Text="分钟后提醒" VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>

            <!-- 错误提示 -->
            <TextBlock x:Name="HintText" Grid.Row="2" Text="请输入 1 以上的整数分钟数" FontSize="11"
                       Foreground="{StaticResource Error}" Margin="16,4,0,0" Visibility="Collapsed"/>

            <!-- 按钮 -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12,16,14">
                <Button Content="取消" Style="{StaticResource BaseButtonStyle}"
                        Click="Cancel_Click" Width="72" Height="30"/>
                <Button Content="确定" Style="{StaticResource PrimaryButton}"
                        Click="Ok_Click" Width="72" Height="30" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

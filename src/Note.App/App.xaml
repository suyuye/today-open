<Application x:Class="NoteApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 霞鹜文楷 Lite 手写字体（嵌入资源，供便签内容区可选使用） -->
            <FontFamily x:Key="HandwritingFont">/Note.App;component/Fonts/#LXGW WenKai Lite</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
    <!--
        便签应用常驻托盘：无启动窗口，进程在托盘常驻。
        使用 OnExplicitShutdown，仅在用户从托盘显式退出时关闭；
        所有便签窗口关闭后进程仍需存活。
    -->
</Application>
